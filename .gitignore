# Firebase CLI local state
.firebase/

# Service-account and other credential material. The app itself never needs any
# of these (it uses the browser Firebase SDK and verifies ID tokens with Google's
# public certificates), so their presence in the working tree always means a key
# was copied in by mistake and must not be committed.
serviceAccount.json
*serviceAccount*.json
firebase-adminsdk*.json
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

