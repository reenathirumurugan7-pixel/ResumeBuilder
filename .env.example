# Firebase configuration
# Copy this file to `.env` and fill in the values from your Firebase Console
# (Project settings > General > Your apps > SDK setup and configuration).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI (server-side only - never exposed to the browser)
GEMINI_API_KEY=
# Must be a model your key can access. gemini-3.5-flash is the default used by
# api/ai/enhance.js and api/ai/parse.js when this is blank or missing: it is a
# stable (non-preview) model that was verified against both request shapes this
# project sends.
# Not every model accepts those shapes - gemini-3.5-flash-lite answers HTTP 400
# on the thinkingBudget:0 config - so check a new model against both endpoints.
# Note: gemini-2.5-flash / -lite now return HTTP 404 ("no longer available to new
# users") on the Generative Language API, so they no longer work here.
GEMINI_MODEL=gemini-3.5-flash

# Server-only. Project ID used to verify Firebase ID tokens on the API.
# Falls back to VITE_FIREBASE_PROJECT_ID when unset, but set it explicitly in
# production so the API never depends on a build-time variable.
FIREBASE_PROJECT_ID=

# Comma-separated list of browser origins allowed to call the AI endpoint.
# Leave blank to allow the Firebase Hosting deploy, localhost dev ports, and the
# current Vercel deployment (auto-detected). Set it explicitly only when using a
# custom domain, e.g. https://resume.example.com,https://www.example.com
AI_ALLOWED_ORIGINS=

# Optional: override the origin used for public resume links / QR codes
# (e.g. your custom domain or a LAN URL for local testing on a phone).
# If unset, local/private hosts fall back to https://resumebuilder-1ca16.web.app
# and deployed hosts use their own origin automatically.
VITE_RESUME_ORIGIN=
